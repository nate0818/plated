<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Frame 0 of the opener: the plain persimmon field, so the launch
	     animation takes over seamlessly (see design handoff §Interactions). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
	</dict>
	<!-- CloudKit silent pushes. Kept here because Xcode accepts
	     INFOPLIST_KEY_UIBackgroundModes as a setting but never emits it
	     into the generated Info.plist. -->
	<!-- Plated ships no encryption of its own: everything on the wire is
	     Apple's (CloudKit, WeatherKit, Sign in with Apple) over HTTPS, which
	     is exempt. Declared here so every TestFlight build skips the
	     "Missing Compliance" hold instead of waiting on a manual answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
