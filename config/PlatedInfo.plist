<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Frame 0 of the opener: the plain persimmon field, so the launch
	     animation takes over seamlessly (see design handoff §Interactions). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchGround</string>
	</dict>
	<!-- plated:// — the scheme every widget's tap URL uses. Routed in
	     MainShellView via DeepLink. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.natemeadows.plated.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>plated</string>
			</array>
		</dict>
	</array>
	<!-- CloudKit silent pushes. Kept here because Xcode accepts
	     INFOPLIST_KEY_UIBackgroundModes as a setting but never emits it
	     into the generated Info.plist. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
