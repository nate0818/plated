<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Reference entitlements. Not wired into the build so the project compiles
	  without a signing team. Add the iCloud and WeatherKit capabilities in
	  Xcode's Signing & Capabilities tab, then replace the container identifier
	  below with your own. See README › Turning on iCloud sync.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.natemeadows.plated</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
