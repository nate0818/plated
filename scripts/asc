#!/usr/bin/env python3
"""
A thin App Store Connect API client, so a TestFlight build reaches the public
link without a trip through the website.

The External group (the one the public link hands out) does not receive new
builds on its own. Internal has "all builds" access; External holds exactly
the builds somebody added to it, and each addition goes through Beta App
Review. Eight builds went to TestFlight on the strength of `testflight.sh`
saying "uploaded" while the public link kept serving build 2. Upload is not
distribution, and this closes the gap.

Signing is done with openssl rather than PyJWT because the Xcode python has
no third-party packages and this has to run on a fresh machine.

Usage:
  scripts/asc builds                     list recent builds and their states
  scripts/asc groups                     list beta groups and their builds
  scripts/asc distribute <build> [group] wait for processing, add to the group,
                                         submit for Beta App Review (default
                                         group: External)
"""
import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

APP_ID = os.environ.get("ASC_APP_ID", "6804332064")
KEY_ID = os.environ.get("ASC_KEY_ID", "PHQC2AV3TY")
ISSUER_ID = os.environ.get("ASC_ISSUER_ID", "dcfbb9f3-5699-4044-a26a-f3c7c98fbd29")
KEY_PATH = os.environ.get(
    "ASC_KEY_PATH",
    os.path.expanduser(f"~/.appstoreconnect/private_keys/AuthKey_{KEY_ID}.p8"))
API = "https://api.appstoreconnect.apple.com/v1"


def b64(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


def token() -> str:
    now = int(time.time())
    header = b64(json.dumps({"alg": "ES256", "kid": KEY_ID, "typ": "JWT"}).encode())
    claims = b64(json.dumps({
        "iss": ISSUER_ID, "iat": now, "exp": now + 900,
        "aud": "appstoreconnect-v1"}).encode())
    msg = f"{header}.{claims}".encode()
    der = subprocess.run(
        ["openssl", "dgst", "-sha256", "-sign", KEY_PATH],
        input=msg, capture_output=True, check=True).stdout
    # openssl emits a DER SEQUENCE of two INTEGERs; JWS wants raw r||s, 32
    # bytes each, so strip the tags and any sign-padding byte.
    i = 2
    r_len = der[i + 1]; r = der[i + 2:i + 2 + r_len]; i += 2 + r_len
    s_len = der[i + 1]; s = der[i + 2:i + 2 + s_len]
    sig = r[-32:].rjust(32, b"\0") + s[-32:].rjust(32, b"\0")
    return msg.decode() + "." + b64(sig)


_TOKEN = None


def call(method: str, path: str, body=None):
    global _TOKEN
    if _TOKEN is None:
        _TOKEN = token()
    url = path if path.startswith("http") else API + path
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "Authorization": "Bearer " + _TOKEN,
        "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req) as resp:
            raw = resp.read()
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        raise SystemExit(f"✗ {method} {path} → {e.code}\n{detail}")


def builds(limit=20):
    res = call("GET", f"/builds?filter[app]={APP_ID}&sort=-uploadedDate&limit={limit}"
                      "&fields[builds]=version,uploadedDate,processingState,expired")
    return res["data"]


def build_named(number: str):
    res = call("GET", f"/builds?filter[app]={APP_ID}&filter[version]={number}"
                      "&fields[builds]=version,uploadedDate,processingState,expired")
    return res["data"][0] if res["data"] else None


def beta_detail(build_id: str):
    return call("GET", f"/builds/{build_id}/buildBetaDetail")["data"]


def groups():
    res = call("GET", f"/betaGroups?filter[app]={APP_ID}&include=builds"
                      "&fields[builds]=version"
                      "&fields[betaGroups]=name,isInternalGroup,hasAccessToAllBuilds,publicLink,builds")
    versions = {b["id"]: b["attributes"]["version"] for b in res.get("included", [])}
    out = []
    for g in res["data"]:
        ids = [b["id"] for b in g.get("relationships", {}).get("builds", {}).get("data", [])]
        out.append({
            "id": g["id"],
            "name": g["attributes"]["name"],
            "internal": g["attributes"]["isInternalGroup"],
            "all_builds": bool(g["attributes"].get("hasAccessToAllBuilds")),
            "public_link": g["attributes"].get("publicLink"),
            "builds": sorted((versions.get(i, "?") for i in ids), key=lambda v: int(v) if v.isdigit() else 0),
        })
    return out


def cmd_builds():
    for b in builds():
        a = b["attributes"]
        state = beta_detail(b["id"])["attributes"]["externalBuildState"]
        flag = " EXPIRED" if a["expired"] else ""
        print(f"build {a['version']:>4}  {a['processingState']:<9} external={state}{flag}  {a['uploadedDate'][:16]}")


def cmd_groups():
    for g in groups():
        kind = "internal" if g["internal"] else "external"
        scope = "all builds" if g["all_builds"] else "builds " + (", ".join(g["builds"]) or "none")
        link = f"  {g['public_link']}" if g["public_link"] else ""
        print(f"{g['name']:<10} {kind:<8} {scope}{link}")


def cmd_distribute(number: str, group_name: str = "External"):
    # Processing is usually five to fifteen minutes after altool returns, and
    # the build does not exist to the API until it starts.
    deadline = time.time() + 45 * 60
    build = None
    while time.time() < deadline:
        build = build_named(number)
        if build and build["attributes"]["processingState"] == "VALID":
            break
        state = build["attributes"]["processingState"] if build else "not yet visible"
        print(f"▸ build {number}: {state}, waiting…", flush=True)
        if build and build["attributes"]["processingState"] in ("FAILED", "INVALID"):
            raise SystemExit(f"✗ build {number} {state}")
        time.sleep(60)
    if not build or build["attributes"]["processingState"] != "VALID":
        raise SystemExit(f"✗ build {number} did not finish processing in 45 minutes")

    target = next((g for g in groups() if g["name"] == group_name), None)
    if target is None:
        raise SystemExit(f"✗ no beta group named {group_name!r}")
    if number in target["builds"]:
        print(f"▸ build {number} is already in {group_name}")
    else:
        call("POST", f"/betaGroups/{target['id']}/relationships/builds",
             {"data": [{"type": "builds", "id": build["id"]}]})
        print(f"▸ build {number} added to {group_name}")

    state = beta_detail(build["id"])["attributes"]["externalBuildState"]
    if state == "READY_FOR_BETA_SUBMISSION":
        call("POST", "/betaAppReviewSubmissions", {"data": {
            "type": "betaAppReviewSubmissions",
            "relationships": {"build": {"data": {"type": "builds", "id": build["id"]}}}}})
        state = beta_detail(build["id"])["attributes"]["externalBuildState"]
        print(f"▸ build {number} submitted for Beta App Review")
    elif state == "MISSING_EXPORT_COMPLIANCE":
        raise SystemExit("✗ export compliance missing: ITSAppUsesNonExemptEncryption "
                         "did not land in the built Info.plist")
    print(f"▸ build {number} external state: {state}")
    if target["public_link"]:
        print(f"▸ public link: {target['public_link']}")


def main(argv):
    if not os.path.exists(KEY_PATH):
        raise SystemExit(f"✗ no API key at {KEY_PATH}")
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip()); return
    cmd, args = argv[1], argv[2:]
    if cmd == "builds":
        cmd_builds()
    elif cmd == "groups":
        cmd_groups()
    elif cmd == "distribute" and args:
        cmd_distribute(*args[:2])
    else:
        raise SystemExit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv)
