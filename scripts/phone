#!/usr/bin/env bash
#
# Put the working tree on Nate's iPhone: build, install, launch.
#
# Merging to main does not touch the phone — installing is a manual step,
# so the phone silently sits at whatever commit was last built to it. This
# is that step, in one command.
#
#   scripts/phone                      build HEAD, install, launch
#   scripts/phone --no-launch          install only, leave the app closed
#   scripts/phone -- -plated-purge-cloud   pass launch arguments to the app
#
# Set PLATED_DEVICE to a UDID to override device discovery.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SCHEME="Plated"
CONFIG="Debug"
BUNDLE_ID="com.natemeadows.plated"
DERIVED="$ROOT/build/DerivedData-device"
LOG="$DERIVED/last-build.log"

launch=1
app_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-launch) launch=0; shift ;;
    --) shift; app_args=("$@"); break ;;
    -h|--help) sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "phone: unknown option '$1' (app arguments go after --)" >&2; exit 2 ;;
  esac
done

say() { printf '\033[1m▸\033[0m %s\n' "$*"; }
die() { printf '\033[31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- device ---
find_device() {
  local json; json="$(mktemp)"
  xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1 || return 1
  python3 - "$json" <<'PY'
import json, sys
devices = json.load(open(sys.argv[1]))["result"]["devices"]
for d in devices:
    if d.get("hardwareProperties", {}).get("reality") == "physical":
        print(d["identifier"], d.get("deviceProperties", {}).get("name", "iPhone"), sep="\t")
        break
PY
}

if [[ -n "${PLATED_DEVICE:-}" ]]; then
  UDID="$PLATED_DEVICE"; NAME="(PLATED_DEVICE)"
else
  found="$(find_device || true)"
  [[ -n "$found" ]] || die "No paired iPhone found. Unlock the phone, keep it on the same
  Wi-Fi (or the cable), and confirm it appears in: xcrun devicectl list devices"
  UDID="${found%%$'\t'*}"; NAME="${found#*$'\t'}"
fi

# ------------------------------------------------------------- freshness ---
HEAD_SHA="$(git -C "$ROOT" rev-parse --short HEAD)"
HEAD_SUB="$(git -C "$ROOT" log -1 --format=%s)"
if git -C "$ROOT" rev-parse --verify --quiet main >/dev/null; then
  behind="$(git -C "$ROOT" rev-list --count HEAD..main 2>/dev/null || echo 0)"
  [[ "$behind" -gt 0 ]] && say "note: main is $behind commit(s) ahead of this tree"
fi
if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
  say "note: shipping uncommitted changes"
fi

say "Building $HEAD_SHA — $HEAD_SUB"
say "Target: $NAME"

# ----------------------------------------------------------------- build ---
mkdir -p "$DERIVED"
# -allowProvisioningUpdates lets Xcode fetch a regenerated profile. Without
# it, turning a capability on in the developer portal changes nothing here:
# the cached profile is reused forever and the build fails claiming the
# capability is missing, which reads as "you didn't tick the box" when the
# box was ticked. testflight.sh has always passed it; this script never did.
if ! xcodebuild -project "$ROOT/Plated.xcodeproj" \
      -scheme "$SCHEME" -configuration "$CONFIG" \
      -destination "platform=iOS,id=$UDID" \
      -derivedDataPath "$DERIVED" \
      -allowProvisioningUpdates \
      build >"$LOG" 2>&1; then
  grep -E "error:|BUILD FAILED" "$LOG" | head -20 >&2 || true
  die "Build failed. Full log: $LOG"
fi

APP="$DERIVED/Build/Products/$CONFIG-iphoneos/$SCHEME.app"
[[ -d "$APP" ]] || die "Build succeeded but $APP is missing."

# --------------------------------------------------------------- install ---
say "Installing"
xcrun devicectl device install app --device "$UDID" "$APP" --timeout 300 >/dev/null \
  || die "Install failed. Unlock the phone and try again."

if [[ "$launch" -eq 1 ]]; then
  say "Launching"
  # devicectl eats app arguments that start with a dash unless they follow
  # its own --, and an already-running app makes the result misleading.
  xcrun devicectl device process launch \
    --terminate-existing --device "$UDID" "$BUNDLE_ID" \
    ${app_args[0]+-- "${app_args[@]}"} >/dev/null \
    || die "Launch failed. Unlock the phone and open Plated by hand."
fi

printf '\033[32m✓\033[0m %s is on %s\n' "$HEAD_SHA" "$NAME"
